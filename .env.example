# Copy to .env and adjust. All optional.

# --- FalkorDB (ephemeral review-neighborhood graphs + Browser) ---
# Uncommon 5xxxx ports to avoid clashing with other local projects.
PLEX_FALKORDB_PORT=56379
PLEX_FALKORDB_BROWSER_PORT=53000
# Tell Plex where FalkorDB is (enables the --falkor viz layer):
PLEX_FALKORDB_URL=redis://localhost:56379

# --- Kùzu Explorer (optional: browse a repo's durable code graph) ---
# Pinned to match the kuzu npm version in this repo:
KUZU_EXPLORER_TAG=0.11.3
KUZU_EXPLORER_PORT=58000
# Absolute path to a repo's code-graph DB file (created by `plex index <repo>`):
KUZU_DB_FILE=/absolute/path/to/your/repo/.plex/graph.kuzu

# --- Plex knowledge / embeddings / mining (optional) ---
# PLEX_KNOWLEDGE_DIR=~/.plex/knowledge
# PLEX_EMBEDDING_PROVIDER=openai        # voyage | openai | ollama | fake (default fake)
# OPENAI_API_KEY=...
# PLEX_LLM_PROVIDER=claude-cli          # mining distiller: claude-cli (default) | anthropic | openai

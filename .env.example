# Copy to .env and adjust. ALL OPTIONAL — Plex is fully embedded (Kùzu), no services.
# This .env is read ONLY by Docker Compose (the optional Kùzu Explorer UI, `pnpm ui:kuzu`).
# The plex binaries read ~/.plex/config.json (via `plex init`) + process env — NOT this file.

# --- Kùzu Explorer (optional: browse a repo's durable code graph + PR brain) ---
KUZU_EXPLORER_TAG=0.11.3      # pin to the kuzu npm version in this repo
KUZU_EXPLORER_PORT=58000      # → http://localhost:58000
KUZU_FILE=graph.kuzu          # db file inside KUZU_DB_DIR (graph.kuzu | brain.kuzu)
# A repo's centralized Plex data dir (~/.plex/repos/<id>/; `plex doctor` prints it).
# The Explorer mounts it at /database:
KUZU_DB_DIR=/absolute/path/to/.plex/repos/<id>

# --- Plex runtime (optional; reference only — NOT read from .env, set as process env) ---
# Prefer `plex init`, which writes ~/.plex/config.json. These are the env vars it covers:
# PLEX_KNOWLEDGE_DIR=~/.plex/knowledge
# PLEX_DATA_DIR=                        # '' = ~/.plex/repos/<id> (default); '.plex' = in-repo (self-ignored)
#
# Embeddings: add semantic knowledge retrieval + the semantic review signals. Pick ONE provider:
# PLEX_EMBEDDING_PROVIDER=voyage        # voyage | openai | gemini | ollama
# VOYAGE_API_KEY=...                    # voyage-code-3 (code-specialized; recommended)
# OPENAI_API_KEY=...                    # text-embedding-3-small
# GEMINI_API_KEY=...                    # gemini-embedding-001
#   (ollama needs no key — runs locally: nomic-embed-text)
# NOTE: switching providers means re-embedding (`plex mine --reset` / re-seed) — vectors
#       from different models are not comparable.
#
# Mining distiller (offline knowledge mining):
# PLEX_LLM_PROVIDER=claude-cli          # claude-cli (default) | anthropic | openai

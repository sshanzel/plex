# Copy to .env and adjust. OPTIONAL, and read by ONE thing: Docker Compose, to run the
# Kùzu Explorer UI (`pnpm ui:kuzu`) for browsing a repo's code graph / PR brain.
#
# Plex itself does NOT read this file. Configure embeddings / API keys / data dir with
# `plex init` (writes ~/.plex/config.json, which the CLI + MCP server read). Don't put
# secrets here — they'd be ignored. See AGENTS.md → "Local services".

# --- Kùzu Explorer ---
KUZU_EXPLORER_TAG=0.11.3      # pin to the kuzu npm version in this repo
KUZU_EXPLORER_PORT=58000      # → http://localhost:58000
KUZU_FILE=graph.kuzu          # db file inside KUZU_DB_DIR (graph.kuzu | brain.kuzu)
# A repo's centralized Plex data dir (~/.plex/repos/<id>/; `plex doctor` prints it).
# The Explorer mounts it at /database:
KUZU_DB_DIR=/absolute/path/to/.plex/repos/<id>

# Copy to .env and adjust. ALL OPTIONAL — Plex is fully embedded (Kùzu), no services.
# This .env is only read by Docker Compose (the optional Kùzu Explorer UI). The plex
# binaries read ~/.plex/config.json (via `plex init`) + the env vars below.

# --- Kùzu Explorer (optional: browse a repo's durable code graph + PR brain) ---
# Pinned to match the kuzu npm version in this repo:
KUZU_EXPLORER_TAG=0.11.3
KUZU_EXPLORER_PORT=58000
# A repo's Plex data DIR + the db filename inside it (default data lives at
# ~/.plex/repos/<id>/; `plex doctor` prints the path). The Explorer mounts /database.
KUZU_DB_DIR=/absolute/path/to/.plex/repos/<id>
KUZU_FILE=graph.kuzu

# --- Plex knowledge / embeddings / mining (optional) ---
# PLEX_KNOWLEDGE_DIR=~/.plex/knowledge
# PLEX_DATA_DIR=                        # '' = ~/.plex/repos/<id> (default); '.plex' = in-repo
# Embeddings add semantic knowledge retrieval + the semantic review signals (optional).
# Prefer `plex init`; or pick ONE provider and set its key:
# PLEX_EMBEDDING_PROVIDER=voyage        # voyage | openai | gemini | ollama
# VOYAGE_API_KEY=...                    # voyage-code-3 (code-specialized; recommended)
# OPENAI_API_KEY=...                    # text-embedding-3-small
# GEMINI_API_KEY=...                    # gemini-embedding-001
#   (ollama needs no key — runs locally: nomic-embed-text)
# NOTE: switching providers means re-embedding (`plex mine --reset` / re-seed) — vectors
# from different models are not comparable.
# PLEX_LLM_PROVIDER=claude-cli          # mining distiller: claude-cli (default) | anthropic | openai

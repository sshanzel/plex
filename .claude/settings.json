{
  "enabledMcpjsonServers": [
    "plex"
  ],
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "mcp__plex__index_repo",
      "mcp__plex__get_review_context",
      "mcp__plex__get_blast_radius",
      "mcp__plex__submit_findings",
      "mcp__plex__reconcile_outcomes",
      "mcp__plex__record_outcome",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)"
    ]
  },
  "extraKnownMarketplaces": {
    "sshanzel": {
      "source": {
        "source": "github",
        "repo": "sshanzel/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pr-master@sshanzel": true
  }
}

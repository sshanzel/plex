# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# test / coverage
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env / secrets
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Plex runtime data. By default this lives OUTSIDE the repo (~/.plex/repos/<id>), so
# nothing is written into the tree — these patterns only matter for the in-repo opt-in
# (PLEX_DATA_DIR=.plex) and as belt-and-suspenders. `.reviewer/` is the legacy name.
.plex/
.reviewer/
*.kuzu
*.kuzu/

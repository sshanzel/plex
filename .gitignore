# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# test / coverage
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env / secrets (Plex has no .env; ignored as a generic safety net)
.env
.env.*

# transient Claude Code agent worktrees (isolation mode) — never part of the repo
.claude/worktrees/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Plex runtime data. By default this lives OUTSIDE the repo (~/.plex/repos/<id>), so
# nothing is written into the tree — these patterns only matter for the in-repo opt-in
# (PLEX_DATA_DIR=.plex) and as belt-and-suspenders. `.reviewer/` is the legacy name.
.plex/
.reviewer/
*.kuzu
*.kuzu/
